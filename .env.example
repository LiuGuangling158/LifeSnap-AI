# Local environment for LifeSnap AI. Copy to .env and fill real secrets.

LIFESNAP_BUSINESS_TIMEZONE=Asia/Shanghai
LIFESNAP_SQLITE_PATH=backend/data/lifesnap.sqlite3
LIFESNAP_AUTH_SESSION_SECRET=replace-with-a-long-random-auth-secret
LIFESNAP_AUTH_SESSION_TTL_MINUTES=480

# Historic local key for the optional compatibility session endpoint. RAG write
# APIs are authorized by an authenticated account with the admin role.
LIFESNAP_ADMIN_KEY=change-this-local-admin-key
LIFESNAP_ADMIN_SESSION_TTL_MINUTES=30
# Keep false in production. Enable only while migrating older API clients.
LIFESNAP_ALLOW_LEGACY_ADMIN_KEY_HEADER=false

# Optional local-dev convenience. Lets the localhost admin page fill the admin key.
LIFESNAP_ALLOW_ADMIN_KEY_REVEAL=false

LIFESNAP_LLM_PROVIDER=deepseek
LIFESNAP_LLM_BASE_URL=https://api.deepseek.com
LIFESNAP_LLM_MODEL=deepseek-v4-flash
LIFESNAP_LLM_REASONING_EFFORT=none
LIFESNAP_LLM_RESPONSE_FORMAT=json_object
LIFESNAP_LLM_TIMEOUT_SECONDS=20

# Chat assistant / intent routing.
LIFESNAP_DEEPSEEK_CHAT_API_KEY=your-deepseek-chat-api-key

# Image bill recognition through Kimi Vision.
LIFESNAP_IMAGE_BILL_API_KEY=your-kimi-image-bill-api-key
LIFESNAP_OCR_PROVIDER=kimi_vision
LIFESNAP_OCR_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
LIFESNAP_OCR_MODEL=kimi-k2.6
LIFESNAP_OCR_TIMEOUT_SECONDS=60

# Default AI parsing for non-chat, non-image flows.
LIFESNAP_DEFAULT_AI_PROVIDER=siliconflow
LIFESNAP_DEFAULT_AI_BASE_URL=https://api.siliconflow.cn/v1
LIFESNAP_DEFAULT_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
LIFESNAP_DEFAULT_AI_API_KEY=your-default-ai-api-key
LIFESNAP_LLM_DEFAULT_API_KEY=your-default-ai-api-key
LIFESNAP_AI_PARSE_API_KEY=your-default-ai-api-key
# LIFESNAP_AI_PARSE_ENDPOINT=https://your-ai-service.example.com/parse

# Optional semantic RAG through an OpenAI-compatible Embeddings API.
# Keep these unset to use local BM25 retrieval only. To use SiliconFlow,
# set its Embeddings endpoint, your key, and an embedding model such as BAAI/bge-m3.
# LIFESNAP_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# LIFESNAP_RAG_EMBEDDING_MODEL=BAAI/bge-m3
# LIFESNAP_RAG_EMBEDDING_API_KEY=your-rag-embedding-api-key
# LIFESNAP_RAG_SEMANTIC_WEIGHT=0.65
